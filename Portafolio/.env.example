# Copia este archivo como .env y completa tus datos reales.
# No subas .env al repositorio.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

AWS_S3_REGION=us-east-2
AWS_S3_BUCKET=mateo-silva-portafolio-web
AWS_CLOUDFRONT_DISTRIBUTION_ID=

PORTFOLIO_PROJECTS_BASE_URL=
PORTFOLIO_PROJECT_SLUGS=

# Estas variables NO son URLs de repositorios.
# Los repositorios salen del campo "repository" dentro de cada project.json.
# Estas variables son URLs publicas donde estan alojadas las aplicaciones desplegadas.
# Usa el slug en mayuscula y reemplaza guiones por guion bajo.
PORTFOLIO_APP_URL_NUTRISNAP=
PORTFOLIO_APP_URL_POKEDEX=
